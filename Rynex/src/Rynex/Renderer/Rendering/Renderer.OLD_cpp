	int Renderer::RenderSecoundaryPasses()
	{
		RY_PROFILE_FUNCTION();

		int renderMode = RenderCommand::GetMode();
		if (!BIT_EQUAL(renderMode, RenderMode::Death_Buffer))
			RenderCommand::SetMode(renderMode | RenderMode::Death_Buffer);
		renderMode = Renderer::GetMode();

		for (std::pair<const std::string, ElementViewPassStorage>& element : s_Storage.MapPasses)
		{
			ElementViewPassStorage& elementViewPassStorage = element.second;
			RefVectorViewPassStorage& refVectorViewPassStorage = elementViewPassStorage.Vec;
			if (nullptr == refVectorViewPassStorage)
				continue;

			VectorViewPassStorage& vectorViewPassStorage = *refVectorViewPassStorage;


			for (ViewPassStorage& pass : vectorViewPassStorage)
			{
				StatusRenderPasses& statePass = s_State.SecundaryPasses.emplace_back(StatusRenderPasses());
				RY_SCOPE_TIMER(statePass.TimeElpassed);
				CamerRenderPackages& camerPackeg = pass.CameraPackege;
				statePass.DrawCallsCount = camerPackeg.GetDrawListCount();
				statePass.PiplineCallsCount = camerPackeg.GetPilineBaseCount();
				RenderTarget& renderTarget = camerPackeg.GetRenderTarget();
				const Ref<Framebuffer> fb = camerPackeg.GetFramebuffer();


				if (nullptr == fb)
					continue;
				const glm::ivec4& viewMointor = camerPackeg.GetViewSpace();

				fb->Bind();
				RenderCommand::ClearDepth();
				if (s_Storage.SortBeforDraw)
				{
					renderTarget.SortePilineList();
				}
				camerPackeg.DrawPass();
#ifdef RY_RENDER_COPY_PIPLINES
				statePass.PiplineBaseVec = renderTarget.GetPiplineRefVecCopy();
#endif
				renderTarget.ClearAlphaPilines();
				renderTarget.ClearPilines();


#if 0
				fb->UnBind();
#endif

			}
		}
		return renderMode;
	}

	void Renderer::RenderMainImage()
	{
		RY_PROFILE_FUNCTION();

		StatusRenderPasses& statePass = s_State.MainPass;
		RY_SCOPE_TIMER(statePass.TimeElpassed);



		ViewPassStorage& mainViewPass = s_Storage.MainViewPass;
		CamerRenderPackages& mainCameraRenderPackege = mainViewPass.CameraPackege;
		RenderTarget& renderTarget = mainCameraRenderPackege.GetRenderTarget();

		statePass.DrawCallsCount = renderTarget.GetDrawListCount();
		statePass.PiplineCallsCount = renderTarget.GetPilineBaseCount();
		int mode = s_Storage.SceneMode;
#if 0
		const Ref<Framebuffer>& fb = mainCameraRenderPackege.GetFramebuffer();
		fb->Bind();
		{
			const glm::vec4& background = s_Storage.MainPass.BackGroundColor;
			if (s_Storage.GammaBackgroundCorction)
			{
				glm::vec3 backgroundRGB = glm::vec4(background);
				glm::vec3 scale = glm::vec3(s_Storage.GammeCorection);
				glm::vec3 vecColorPow = glm::pow(backgroundRGB, scale);
				glm::vec4 clearColor = glm::vec4(vecColorPow, background.a);
				RenderCommand::SetClearColor(clearColor);
			}
			else
			{
				RenderCommand::SetClearColor(background);
			}
			if (1u < fb->GetAttachmentTexturesSize())
				fb->ClearAttachment(1, -1);
		}
#else
		renderTarget.BindFramebuffer();
		renderTarget.ClearFramebufferImges();
		renderTarget.ClearFramebufferDepth();
#endif

		Ref<Texture> texCheckeBord = Renderer3D::GetDefoultChekebordTex();
		if (s_Storage.SortBeforDraw)
		{
			renderTarget.SortePilineList();
		}
		mainCameraRenderPackege.DrawPass(mode);

#ifdef RY_RENDER_COPY_PIPLINES
		statePass.PiplineBaseVec = renderTarget.GetPiplineRefVecCopy();
#endif
		renderTarget.ClearAlphaPilines();
		renderTarget.ClearPilines();


		RenderCommand::SetMode(mode);
#if 0
		Renderer2D::RenderText();
		Renderer2D::DrawQuads();
		Renderer2D::RenderIcons();
#endif

		renderTarget.ClearPilines();
		renderTarget.ClearAlphaPilines();
#if 0
		fb->UnBind();
#endif
	}

	const RenderTarget Renderer::DirecktMainRenderingTarget(const RenderTarget& target)
	{
		RenderTarget& refTarget = Renderer::GetMainRenderTargetRef();
		const RenderTarget tragetTemp = refTarget;
		refTarget = target;
		return tragetTemp;
	}

	void Renderer::RenderSubmitSceneMainNow(const RenderTarget& target)
	{
		Renderer2D::SubmitRenderDrawList();
		Renderer3D::SubmitRenderIndrectDrawList();

		Renderer::RenderMainImageOnly();

		RenderCommand::RestPipline();
		Renderer3D::FrameFinshed();


		RenderTarget& refTarget = Renderer::GetMainRenderTargetRef();
		refTarget = target;

	}

	void Renderer::RenderMainImageOnly()
	{


		int renderMode = RenderCommand::GetMode();
		if (!BIT_EQUAL(renderMode, RenderMode::Death_Buffer))
			RenderCommand::SetMode(renderMode | RenderMode::Death_Buffer);
		renderMode = Renderer::GetMode();

		RY_PROFILE_FUNCTION();

		StatusRenderPasses& statePass = s_State.MainPass;
		RY_SCOPE_TIMER(statePass.TimeElpassed);


		ViewPassStorage& mainViewPass = s_Storage.MainViewPass;
		CamerRenderPackages& mainCameraRenderPackege = mainViewPass.CameraPackege;
		RenderTarget& renderTarget = mainCameraRenderPackege.GetRenderTarget();

		statePass.DrawCallsCount = renderTarget.GetDrawListCount();
		statePass.PiplineCallsCount = renderTarget.GetPilineBaseCount();
		int mode = s_Storage.SceneMode;
#if 0
		const Ref<Framebuffer>& fb = mainCameraRenderPackege.GetFramebuffer();
		fb->Bind();


		const glm::vec4& background = s_Storage.MainPass.BackGroundColor;
		if (s_Storage.GammaBackgroundCorction)
		{
			glm::vec3 backgroundRGB = glm::vec4(background);
			glm::vec3 scale = glm::vec3(s_Storage.GammeCorection);
			glm::vec3 vecColorPow = glm::pow(backgroundRGB, scale);
			glm::vec4 clearColor = glm::vec4(vecColorPow, background.a);
			RenderCommand::SetClearColor(clearColor);
		}
		else
		{
			RenderCommand::SetClearColor(background);
		}
		if (1u < fb->GetAttachmentTexturesSize())
			fb->ClearAttachment(1, -1);
#else
		renderTarget.BindFramebuffer();

		renderTarget.ClearShaderDrawList();
		renderTarget.ClearFrambuffer();

		// renderTarget.ClearFramebufferDepth();
#endif
		RenderCommand::Clear();

		Ref<Texture> texCheckeBord = Renderer3D::GetDefoultChekebordTex();
		if (s_Storage.SortBeforDraw)
		{
			renderTarget.SortePilineList();
		}
		mainCameraRenderPackege.DrawPass(mode);

#ifdef RY_RENDER_COPY_PIPLINES
		statePass.PiplineBaseVec = renderTarget.GetPiplineRefVecCopy();
#endif

		renderTarget.ClearAlphaPilines();
		renderTarget.ClearPilines();
		// renderTarget.ClearShaderDrawList();
		// RenderCommand::SetMode(mode);
#if 0
		Renderer2D::RenderText();
		Renderer2D::DrawQuads();
		Renderer2D::RenderIcons();
#endif


#if 0
		fb->UnBind();
#endif

		Renderer::SetMode(renderMode);
	}

