	void Renderer::SetMainPassView(ViewPassData& viewPass)
	{
		ViewPassStorage& mainViewPass = s_Storage.MainViewPass;
		CamerRenderPackages& mainCameraRenderPackege = mainViewPass.CameraPackege;

		if (s_Storage.GammaBackgroundCorction)
			viewPass.GammeCorection = s_Storage.GammeCorection;

		s_Storage.MainPass = viewPass;
		mainCameraRenderPackege.SetFromViewPass(viewPass);
		RenderTarget& target = mainCameraRenderPackege.GetRenderTarget();

		if (s_Storage.GammaBackgroundCorction)
		{
			glm::vec3 backgroundRGB = glm::vec3(viewPass.BackGroundColor);
			glm::vec3 scale = glm::vec3(s_Storage.GammeCorection);
			glm::vec3 vecColorPow = glm::pow(backgroundRGB, scale);
			glm::vec4 clearColor = glm::vec4(vecColorPow, viewPass.BackGroundColor.a);
			target.SetClearColorAttachment(0, clearColor);
		}
		else
		{
			target.SetClearColorAttachment(0, viewPass.BackGroundColor);
		}
		target.SetClearColorAttachment(1, -1);
	}

