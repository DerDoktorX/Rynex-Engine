namespace Rynex {

	struct Storage
	{
		ViewPassStorage MainViewPass;
		ViewPassData MainPass;
#if RY_VIEWPORT_PASS

		CameraData MainCameraData;
		DisplayData MainDisplayData;
		Ref<UniformBuffer> MainCamerBuffer;
		Ref<UniformBuffer> MainDisplayBuffer;
		RenderTarget RenderTargetObject;

#else

#endif
#if 1
		MapRefVectorViewPassStorage MapPasses;
#else
		std::vector<ViewPassStorage> PassViews;
		uint32_t PassSlots;
#endif
		bool GammaBackgroundCorction = true;
		bool SortBeforDraw = false;
		float GammeCorection = 2.2f;
		int SceneMode = 0;

	};

	struct RenderStorage
	{
		glm::mat4 Model;
		glm::mat4 View;
		glm::mat4 Projection;
		std::array<Plane, 6> BoundingArray;

		Ref<UniformBuffer> CamerUB;
		Ref<UniformBuffer> DisplayUB;
	};

	struct RenderTargetStorage
	{
		RenderTarget Target;

		uint32_t CameraIndexCount;
		std::vector<uint32_t> CameraVec;
	};

	static Storage s_Storage;

	static StatusRender s_State;


	void Renderer::Init()
	{
		s_Init = true;
#if RY_VIEWPORT_PASS
		s_Storage.MainCamerBuffer = UniformBuffer::Create(&s_Storage.MainCameraData, sizeof(CameraData),
			{
				 { ShaderDataType::Float4x4, "ViewProjectionMatrix" },
				 { ShaderDataType::Float4x4, "ViewMatrix" },
				 { ShaderDataType::Float4x4, "ProjectionMatrix" },
				 { ShaderDataType::Float3,   "CamerPosition" },
				 { ShaderDataType::Int,      "Empty"}
			}, 0);

		s_Storage.MainDisplayBuffer = UniformBuffer::Create(&s_Storage.MainCameraData, sizeof(DisplayData),
			{
				 { ShaderDataType::Float4, "ViewPortConf" },
			}, 1);

		s_Storage.RenderTargetObject.ClearShaderDrawList();
#else
		s_Storage.MainViewPass = ViewPassStorage();
		ViewPassStorage& mainViewPass = s_Storage.MainViewPass;
		mainViewPass.Type = ViewPassType::MainView;
		mainViewPass.Slot = static_cast<uint32_t>(-1);

#endif
		RenderCommand::Init();
		BufferAPI::Init();
		Renderer2D::Init();
		Renderer3D::Init();
	}

	void Renderer::InitEditor()
	{

		Renderer2D::InitEditor();
		Renderer3D::InitEditor();
	}


	void Renderer::Shutdown()
	{
		AssetManager::Shutdown();
		BufferAPI::Shutdown();
		Renderer2D::Shutdown();
		Renderer3D::Shutdown();
		Texture::Shutdown();
		Shader::Shutdown();
		Font::ResetDefault();
		s_State.MainPass.PiplineBaseVec.clear();
		s_State.SecundaryPasses.clear();
#if RY_VIEWPORT_PASS
		ViewPassData& mainPass = s_Storage.MainPass;
		ViewPassStorage& mainPassStorage = s_Storage.MainViewPass;
		RY_DESTROY_REF(mainPass.FrameBuffer);

		RY_DESTROY_REF(mainPassStorage.Pass.FrameBuffer);
		mainPassStorage.RenderTargetObject.ClearFrambuffer();
		mainPassStorage.RenderTargetObject.ClearShaderDrawList();

		RY_DESTROY_REF(s_Storage.MainCamerBuffer);

		RY_DESTROY_REF(s_Storage.MainDisplayBuffer);

		s_Storage.RenderTargetObject.ClearShaderDrawList();
		s_Storage.RenderTargetObject.ClearFrambuffer();
#else
		s_Storage.MainViewPass.CameraPackege.DestoryBuffers();
#endif
		s_Init = false;
#if 1
		s_Storage.MapPasses.clear();
		RY_DESTROY_REF(s_Storage.MainPass.FrameBuffer);
#else
		s_Storage.PassViews.clear();
#endif
		RenderCommand::Shutdown();
	}

	void Renderer::ShutdownEditor()
	{
		Renderer2D::ShutdownEditor();
		Renderer3D::ShutdownEditor();
	}

