	uint32_t Renderer::SetPassView(const std::string& passType, ViewPassData& viewPass, ViewPassType type)
	{
		uint32_t slot = -1;
		ViewPassStorage& pass = CreateViewPassDataAt(passType, slot);
		CamerRenderPackages& passCameraRenderPackege = pass.CameraPackege;

		if (s_Storage.GammaBackgroundCorction)
			viewPass.GammeCorection = s_Storage.GammeCorection;

		passCameraRenderPackege.SetFromViewPass(viewPass);

		pass.Slot = slot;
		return slot;
	}

