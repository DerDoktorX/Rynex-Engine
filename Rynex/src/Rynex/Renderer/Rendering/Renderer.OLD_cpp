	uint32_t Renderer::GetPassSepertSize()
	{
		return s_Storage.MapPasses.size();
	}

	uint32_t Renderer::GetPassViewSepertSize(const std::string& passType)
	{
		ElementViewPassStorage& elementViewPassStorage = s_Storage.MapPasses[passType];

		RefVectorViewPassStorage& refVecPasses = elementViewPassStorage.Vec;
		if (nullptr == refVecPasses)
			return 0u;

		VectorViewPassStorage& vecPasses = *refVecPasses;
		uint32_t count = vecPasses.size();
		uint32_t countStore = elementViewPassStorage.PassSlot;
		RY_CORE_ASSERT(count == countStore);
		return count;
	}

	void Renderer::RenderSubmitSceneMain()
	{
		RY_PROFILE_FUNCTION();

		int renderMode = Renderer::RenderSecoundaryPasses();
		Renderer::RenderMainImage();

		Renderer::SetMode(renderMode);
		RenderCommand::RestPipline();
		Renderer3D::FrameFinshed();
	}


