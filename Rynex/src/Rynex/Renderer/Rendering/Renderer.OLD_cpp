#if 0
	inline ViewPassStorage& Renderer::GetViewPassDataAt(uint32_t slot)
	{
		uint32_t size = s_Storage.PassViews.size();
		if (slot < size)
			return s_Storage.PassViews.at(slot);
		else if (slot > size)
		{
			RY_CORE_WARN("Not Expexted Order! slot: {}, size: {}, empty Places {}", slot, size, slot - size);
			s_Storage.PassViews.resize(slot + 1LU);
		}
		else if (slot == size)
		{
			s_Storage.PassViews.emplace_back<ViewPassStorage>(ViewPassStorage{});
		}
		else
		{
			RY_CORE_ERROR("slot {}, size {}", slot, size);
			RY_CORE_ASSERT(false, "not defined State");
		}
		return s_Storage.PassViews.at(slot);
	}
#else
	inline ViewPassStorage& Renderer::CreateViewPassDataAt(const std::string& passType, uint32_t& slot)
	{
		ElementViewPassStorage& elementViewPassStorage = s_Storage.MapPasses[passType];
		RefVectorViewPassStorage& refVecPasses = elementViewPassStorage.Vec;
		if (refVecPasses == nullptr)
		{
			refVecPasses = CreateRef<VectorViewPassStorage>();
		}

		if (slot == -1)
		{
			slot = elementViewPassStorage.PassSlot;
			elementViewPassStorage.PassSlot++;

		}

		std::vector<ViewPassStorage>& viewPassVec = *refVecPasses;
		uint32_t size = viewPassVec.size();
		if (slot < size)
			return viewPassVec.at(slot);
		else if (slot > size)
		{
			RY_CORE_WARN("Not Expexted Order! slot: {}, size: {}, empty Places {}", slot, size, slot - size);
			elementViewPassStorage.PassSlot = slot;
			viewPassVec.resize(slot + 1LU);
		}
		else if (slot == size)
		{
			viewPassVec.emplace_back<ViewPassStorage>(ViewPassStorage{});
		}
		else
		{
			RY_CORE_ERROR("slot {}, size {}", slot, size);
			RY_CORE_ASSERT(false, "not defined State");
		}
		return viewPassVec.at(slot);
	}
#endif

	inline ViewPassStorage& Renderer::GetViewPassDataAt(const std::string& passType, uint32_t slot)
	{
		ElementViewPassStorage& elementViewPassStorage = s_Storage.MapPasses[passType];
		RefVectorViewPassStorage& refVecPasses = elementViewPassStorage.Vec;
		RY_CORE_ASSERT(nullptr != refVecPasses);

		std::vector<ViewPassStorage>& viewPassVec = *refVecPasses;
		uint32_t count = viewPassVec.size();
		RY_CORE_ASSERT(count > slot);
		ViewPassStorage& viewPass = viewPassVec.at(slot);
		return viewPass;
	}


}