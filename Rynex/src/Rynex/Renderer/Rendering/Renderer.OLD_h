#if 0
	template<typename T>
	class BaseAutoVector
	{
	public:
		virtual ~BaseAutoVector() {}

		virtual T& At(uint32_t index) = 0;
		virtual const T& At(uint32_t index) const = 0;

		virtual T& AtAt(uint32_t x, uint32_t y = MAXUINT32) = 0;
		virtual const T& AtAt(uint32_t x, uint32_t y = MAXUINT32) const = 0;

		virtual uint32_t Size() const = 0;
		virtual void Clear() = 0;
		virtual void ReserveVec(uint32_t size) = 0;
		virtual void ResizeVec(uint32_t size) = 0;
	};


	template<typename T>
	class AutoVector : public BaseAutoVector<T>
	{
	public:
		AutoVector()
			: m_Vector()
		{
		}

		virtual ~AutoVector()
		{
			m_Vector.clear();
			m_Vector.shrink_to_fit();
		}

		virtual T& At(uint32_t index) override
		{
			RY_CORE_ASSERT(index <= Size(), "We dont push a Vector not more then one Element! You try to push {} new Elements in.", index - Size());
			if (index == Size())
				m_Vector.emplace_back<T>(std::vector<T>{});

			return m_Vector.at(index);
		}

		virtual const T& At(uint32_t index) const override
		{
			RY_CORE_ASSERT(index < Size(), "We dont push a Vector! You try to push {} new Elements in.", index - Size());
			return m_Vector.at(index);
		}

		virtual T& AtAt(uint32_t x, uint32_t y = MAXUINT32) override
		{
			uint32_t index = x + 2 * y;
			RY_CORE_ASSERT(index < Size(), "We dont push a Vector! You try to push {} new Elements in.", index - Size());
			return m_Vector.at(index);
		}

		virtual const T& AtAt(uint32_t x, uint32_t y = MAXUINT32) const override
		{
			uint32_t index = x + 2 * y;
			RY_CORE_ASSERT(index < Size(), "We dont push a Vector! You try to push {} new Elements in.", index - Size());
			return m_Vector.at(index);
		}

		virtual uint32_t Size() const override { return static_cast<uint32_t>(m_Vector.size()); }

		virtual void Clear() override
		{
			m_Vector.clear();
		}

		virtual void ReserveVec(uint32_t size) override
		{
			m_Vector.reserve(size);
		}

		virtual void ResizeVec(uint32_t size) override
		{
			m_Vector.resize(size);
		}
	private:
		std::vector<T> m_Vector;
	};

	template<typename T>
	class DoubleVector : public BaseAutoVector<T>
	{
	public:
		DoubleVector()
			: m_Vector()
		{
		}

		virtual ~DoubleVector()
		{
			m_Vector.clear();
			m_Vector.shrink_to_fit();
		}

		virtual T& At(uint32_t index) override
		{
			RY_CORE_FUNC_LOG();

			return T();
		}

		std::vector<T>& AtVec(uint32_t index)
		{

			RY_CORE_ASSERT(x <= Size(), "We dont push a Vector not more then one Element! You try to push {} new Elements in.", x - Size());
			if (x == Size())
				m_Vector.emplace_back<std::vector<T>>(std::vector<T>{});

			std::vector<T>& vec = m_Vector.at(index);

			return vec;
		}

		virtual T& AtAt(uint32_t x, uint32_t y = MAXUINT32) override
		{
			RY_CORE_ASSERT(y != MAXUINT32);
			RY_CORE_ASSERT(x <= Size(), "We dont push a Vector not more then one Element! You try to push {} new Elements in.", x - Size());
			if (x == Size())
				m_Vector.emplace_back<std::vector<T>>(std::vector<T>{});
			std::vector<T>& vec = m_Vector.at(x);

			uint32_t sizeVecInVec = static_cast<uint32_t>(vec.size());
			RY_CORE_ASSERT(y <= Size(), "We dont push a Vector not more then one Element! You try to push {} new Elements in.", y - sizeVecInVec);
			if (sizeVecInVec == y)
				m_Vector.emplace_back<T>(T{});

			return m_Vector.at(y);
		}



		virtual const T& AtAt(uint32_t x, uint32_t y = MAXUINT32) const override
		{
			RY_CORE_ASSERT(y != MAXUINT32);
			RY_CORE_ASSERT(x < Size(), "We dont push a Vector! You try to push {} new Elements in.", x - Size());
			const std::vector<T>& vec = m_Vector.at(x);

			uint32_t sizeVecInVec = static_cast<uint32_t>(vec.size());
			RY_CORE_ASSERT(y < Size(), "We dont push a Vector! You try to push {} new Elements in.", y - sizeVecInVec);;

			return m_Vector.at(y);
		}

		virtual const std::vector<T>& At(uint32_t index) const override
		{
			RY_CORE_ASSERT(index < Size(), "We dont push a Vector! You try to push {} new Elements in.", index - Size());
			return m_Vector.at(index);
		}

		virtual uint32_t Size() const override { return static_cast<uint32_t>(m_Vector.size()); }

		virtual void Clear() override
		{
			m_Vector.clear();
		}

		virtual void ReserveVec(uint32_t size) override
		{
			m_Vector.reserve(size);
		}

		virtual void ResizeVec(uint32_t size) override
		{
			m_Vector.resize(size);
		}
	private:
		std::vector<std::vector<T>> m_Vector;
	};

	template<typename T, uint32_t _SizeArray>
	class AutoVectorArray : public BaseAutoVector<T>
	{
	public:
		AutoVectorArray()
			: m_Vector()
		{
		}

		virtual ~AutoVectorArray()
		{
			m_Vector.clear();
			m_Vector.shrink_to_fit();
		}

		virtual T& At(uint32_t index) override
		{
			RY_CORE_NOT_IMPL();
			return T();
		}

		virtual const T& At(uint32_t index) const override
		{
			RY_CORE_NOT_IMPL();
			return T();
		}


		virtual T& At(uint32_t index) override
		{
			RY_CORE_NOT_IMPL();
			return T();
		}

		virtual std::array<T, _SizeArray>& At(uint32_t index) override
		{
			RY_CORE_ASSERT(index <= Size(), "We dont push a Vector not more then one Element! You try to push {} new Elements in.", index - Size());
			if (index == Size())
				m_Vector.emplace_back<std::vector<T>>(std::vector<T>{});
			std::array<T, _SizeArray>& array = m_Vector.at(index);

			return array;
		}

		virtual const std::array<T, _SizeArray>& At(uint32_t index) const override
		{
			RY_CORE_ASSERT(index < Size(), "We dont push a Vector not in a Const Call! You try to push {} new Elements in.", index - Size());

			const std::array<T, _SizeArray>& array = m_Vector.at(index);

			return array;
		}

		virtual T& AtAt(uint32_t x, uint32_t y = MAXUINT32) override
		{
			RY_CORE_ASSERT(y != MAXUINT32);
			RY_CORE_ASSERT(x <= Size(), "We dont push a Vector not more then one Element! You try to push {} new Elements in.", x - Size());
			if (x == Size())
				m_Vector.emplace_back<std::vector<T>>(std::vector<T>{});
			std::array<T, _SizeArray>& array = m_Vector.at(x);

			uint32_t sizeVecInVec = static_cast<uint32_t>(array.size());
			RY_CORE_ASSERT(y < sizeVecInVec, "We dont push a Vector not more then one Element! You try to push {} new Elements in.", y - sizeVecInVec);


			return array.at(y);
		}

		virtual const T& AtAt(uint32_t x, uint32_t y = MAXUINT32) const override
		{
			RY_CORE_ASSERT(y != MAXUINT32);
			RY_CORE_ASSERT(x < Size(), "We dont push a Vector not in a Const Call! You try to push {} new Elements in.", x - Size());

			const std::array<T>& array = m_Vector.at(x);

			uint32_t sizeVecInVec = static_cast<uint32_t>(array.size());
			RY_CORE_ASSERT(y < sizeVecInVec, "We dont push a Vector not in a Const Call! You try to push {} new Elements in.", y - sizeVecInVec);


			return array.at(y);
		}



		virtual uint32_t Size() const override { return static_cast<uint32_t>(m_Vector.size()); }

		virtual void Clear() override
		{
			m_Vector.clear();
		}

		virtual void ReserveVec(uint32_t size) override
		{
			m_Vector.reserve(size);
		}

		virtual void ResizeVec(uint32_t size) override
		{
			m_Vector.resize(size);
		}
	private:
		std::vector<std::array<T, _SizeArray>> m_Vector;
	};
#endif

	namespace RenderMode {
		enum {
			Empty = BIT(31),
			None = 0,
			CallFace_None = BIT(0),
			CallFace_Front = BIT(1),
			CallFace_Back = BIT(2),
			CallFace_FrontBack = BIT(3),
			WireFrame = BIT(4),
			A_Buffer = BIT(5),
			Death_Buffer = BIT(6),
			Gamma = BIT(7),
			PrimitivReset = BIT(8)
		};
	}

