	struct ViewPassData
	{
		glm::mat4 ProjetionMatrix;
		glm::mat4 ViewMatrix;
		glm::mat4 ProjetionViewMatrix;
		glm::mat4 InverseProjetionViewMatrix;
		glm::vec3 Postion;
		glm::vec4 BackGroundColor;
		glm::ivec4 ViewSpace;	// w/z = withe/heigth | x/y = offset(x/y)
		int Modes;
		float GammeCorection = 2.2f;
		bool RenderEcheFrame = true;
		bool RenderFrame = true;

		Ref<Framebuffer> FrameBuffer;

		ViewPassData(const glm::mat4& projetionMatrix, const glm::mat4& viewMatrix, const glm::vec3& postion,
			const glm::vec4& backGroundColor, const glm::ivec4& viewSpace,
			int modes, float gammeCorection, const Ref<Framebuffer>& frameBuffer,
			bool renderEcheFrame = true, bool renderFrame = true)
			: ProjetionMatrix(projetionMatrix)
			, ViewMatrix(viewMatrix)
			, ProjetionViewMatrix(projetionMatrix* viewMatrix)
			, InverseProjetionViewMatrix(glm::mat4(0.0f))
			, Postion(postion)
			, BackGroundColor(backGroundColor)
			, ViewSpace(viewSpace)
			, Modes(modes)
			, GammeCorection(gammeCorection)
			, FrameBuffer(frameBuffer)
			, RenderEcheFrame(renderEcheFrame)
			, RenderFrame(renderFrame)
		{
			InverseProjetionViewMatrix = glm::inverse(ProjetionViewMatrix);
		}
	};

	enum class ViewPassType
	{
		None = 0,
		DepthTest,
		Shadow,
		RenderTarget,
		SlectedView,
		Custemiced,
		MainView
	};

	struct StatusRenderPasses
	{
		int64_t TimeElpassed;
		uint32_t DrawCallsCount;
		uint32_t PiplineCallsCount;
	};

	struct StatusRender
	{
		StatusRenderPasses MainPass;
		std::vector<StatusRenderPasses> SecundaryPasses;

	};

	struct ViewPassStorage
	{
		ViewPassType Type;
		uint32_t Slot;
#if RY_VIEWPORT_PASS

		ViewPassData Pass;
		CameraData CameraData;
		DisplayData DisplayDataObject;
		Ref<UniformBuffer> CamerBuffer;
		Ref<UniformBuffer> DisplayBuffer;
		Ref<UniformBuffer> DataBuffer;
		RenderTarget RenderTargetObject;
#else
		CamerRenderPackages CameraPackege;
#endif
		ViewPassStorage()
			: Type(ViewPassType())
			, Slot(0u)
#if RY_VIEWPORT_PASS
			, Pass(ViewPassData())
			, DisplayDataObject(DisplayData())
			, CamerBuffer(nullptr)
			, DisplayBuffer(nullptr)
			, RenderTargetObject(RenderTarget())
#else
			, CameraPackege(CamerRenderPackages())
#endif
		{
		}

		RenderTarget& GetRenderTaget()
		{
			RenderTarget& target = CameraPackege.GetRenderTarget();
			return target;
		}

		Ref<UniformBuffer> GetUniformCamera()
		{
			CamerRenderPackages::CamerPackage& packeg = CameraPackege.GetCamerPackage();
			Ref<UniformBuffer> uniformBuffer = packeg.GetBuffer();
			return uniformBuffer;
		}

		Ref<UniformBuffer> GetUniformDisplay()
		{
			CamerRenderPackages::DisplayPackage& packeg = CameraPackege.GetDisplayPackage();
			Ref<UniformBuffer> uniformBuffer = packeg.GetBuffer();
			return uniformBuffer;
		}

		Ref<UniformBuffer> GetUniformDebug()
		{
			CamerRenderPackages::DebugCamerPackage& packeg = CameraPackege.GetDebugPackage();
			Ref<UniformBuffer> uniformBuffer = packeg.GetBuffer();
			return uniformBuffer;
		}
	};

	typedef std::vector<ViewPassStorage> VectorViewPassStorage;
	typedef Ref<VectorViewPassStorage> RefVectorViewPassStorage;

	struct ElementViewPassStorage
	{
		uint32_t PassSlot = 0;
		RefVectorViewPassStorage Vec;
	};

	typedef std::map<std::string, ElementViewPassStorage> MapRefVectorViewPassStorage;

	struct ObjectRendereIndex {
		uint32_t BatchIndex = 0xFFFFFFFFui32;
		uint32_t PiplineIndex = 0xFFFFFFFFui32;

		void Reset()
		{
			BatchIndex = 0xFFFFFFFFui32;
			PiplineIndex = 0xFFFFFFFFui32;
		}
	};

	struct SingleMeshRender : public MeshStatic::SingleObjectMeshData
	{
		glm::mat4 GlobelNodeMatrix;

		std::vector<ObjectRendereIndex> IndexVec;
		SingleMeshRender()
			: IndexVec()
			, GlobelNodeMatrix(glm::mat4(1.0f))
			, MeshStatic::SingleObjectMeshData(nullptr, nullptr, glm::mat4(0.0f), "Default-Name", 0xFFFFFFFFui32, 0xFFFFFFFFui32)

		{

		}


		SingleMeshRender(const MeshStatic::SingleObjectMeshData& singleObjectMeshRender)
			: IndexVec()
			, GlobelNodeMatrix(glm::mat4(1.0f))
			, MeshStatic::SingleObjectMeshData(singleObjectMeshRender)
		{
		}

		SingleMeshRender(const Ref<MeshSingle>& meshSingle, const Ref<Material>& materiel, const glm::mat4& localeMatrix)
			: IndexVec()
			, GlobelNodeMatrix(glm::mat4(0.0f))
			, MeshStatic::SingleObjectMeshData(meshSingle, materiel, localeMatrix, "Set-No-Same", 0xFFFFFFFFui32, 0xFFFFFFFFui32)
		{
		}

		SingleMeshRender(const SingleMeshRender&) = default;

		void SetEntityMatrix(const glm::mat4& matrix)
		{
			GlobelNodeMatrix = matrix * LocaleCildrenMatrix;
		}


		void ResetIndex()
		{
			IndexVec.clear();
		}
	};


#if 0
	template<typename T>
	class BaseAutoVector
	{
	public:
		virtual ~BaseAutoVector() {}

		virtual T& At(uint32_t index) = 0;
		virtual const T& At(uint32_t index) const = 0;

		virtual T& AtAt(uint32_t x, uint32_t y = MAXUINT32) = 0;
		virtual const T& AtAt(uint32_t x, uint32_t y = MAXUINT32) const = 0;

		virtual uint32_t Size() const = 0;
		virtual void Clear() = 0;
		virtual void ReserveVec(uint32_t size) = 0;
		virtual void ResizeVec(uint32_t size) = 0;
	};


	template<typename T>
	class AutoVector : public BaseAutoVector<T>
	{
	public:
		AutoVector()
			: m_Vector()
		{
		}

		virtual ~AutoVector()
		{
			m_Vector.clear();
			m_Vector.shrink_to_fit();
		}

		virtual T& At(uint32_t index) override
		{
			RY_CORE_ASSERT(index <= Size(), "We dont push a Vector not more then one Element! You try to push {} new Elements in.", index - Size());
			if (index == Size())
				m_Vector.emplace_back<T>(std::vector<T>{});

			return m_Vector.at(index);
		}

		virtual const T& At(uint32_t index) const override
		{
			RY_CORE_ASSERT(index < Size(), "We dont push a Vector! You try to push {} new Elements in.", index - Size());
			return m_Vector.at(index);
		}

		virtual T& AtAt(uint32_t x, uint32_t y = MAXUINT32) override
		{
			uint32_t index = x + 2 * y;
			RY_CORE_ASSERT(index < Size(), "We dont push a Vector! You try to push {} new Elements in.", index - Size());
			return m_Vector.at(index);
		}

		virtual const T& AtAt(uint32_t x, uint32_t y = MAXUINT32) const override
		{
			uint32_t index = x + 2 * y;
			RY_CORE_ASSERT(index < Size(), "We dont push a Vector! You try to push {} new Elements in.", index - Size());
			return m_Vector.at(index);
		}

		virtual uint32_t Size() const override { return static_cast<uint32_t>(m_Vector.size()); }

		virtual void Clear() override
		{
			m_Vector.clear();
		}

		virtual void ReserveVec(uint32_t size) override
		{
			m_Vector.reserve(size);
		}

		virtual void ResizeVec(uint32_t size) override
		{
			m_Vector.resize(size);
		}
	private:
		std::vector<T> m_Vector;
	};

	template<typename T>
	class DoubleVector : public BaseAutoVector<T>
	{
	public:
		DoubleVector()
			: m_Vector()
		{
		}

		virtual ~DoubleVector()
		{
			m_Vector.clear();
			m_Vector.shrink_to_fit();
		}

		virtual T& At(uint32_t index) override
		{
			RY_CORE_FUNC_LOG();

			return T();
		}

		std::vector<T>& AtVec(uint32_t index)
		{

			RY_CORE_ASSERT(x <= Size(), "We dont push a Vector not more then one Element! You try to push {} new Elements in.", x - Size());
			if (x == Size())
				m_Vector.emplace_back<std::vector<T>>(std::vector<T>{});

			std::vector<T>& vec = m_Vector.at(index);

			return vec;
		}

		virtual T& AtAt(uint32_t x, uint32_t y = MAXUINT32) override
		{
			RY_CORE_ASSERT(y != MAXUINT32);
			RY_CORE_ASSERT(x <= Size(), "We dont push a Vector not more then one Element! You try to push {} new Elements in.", x - Size());
			if (x == Size())
				m_Vector.emplace_back<std::vector<T>>(std::vector<T>{});
			std::vector<T>& vec = m_Vector.at(x);

			uint32_t sizeVecInVec = static_cast<uint32_t>(vec.size());
			RY_CORE_ASSERT(y <= Size(), "We dont push a Vector not more then one Element! You try to push {} new Elements in.", y - sizeVecInVec);
			if (sizeVecInVec == y)
				m_Vector.emplace_back<T>(T{});

			return m_Vector.at(y);
		}



		virtual const T& AtAt(uint32_t x, uint32_t y = MAXUINT32) const override
		{
			RY_CORE_ASSERT(y != MAXUINT32);
			RY_CORE_ASSERT(x < Size(), "We dont push a Vector! You try to push {} new Elements in.", x - Size());
			const std::vector<T>& vec = m_Vector.at(x);

			uint32_t sizeVecInVec = static_cast<uint32_t>(vec.size());
			RY_CORE_ASSERT(y < Size(), "We dont push a Vector! You try to push {} new Elements in.", y - sizeVecInVec);;

			return m_Vector.at(y);
		}

		virtual const std::vector<T>& At(uint32_t index) const override
		{
			RY_CORE_ASSERT(index < Size(), "We dont push a Vector! You try to push {} new Elements in.", index - Size());
			return m_Vector.at(index);
		}

		virtual uint32_t Size() const override { return static_cast<uint32_t>(m_Vector.size()); }

		virtual void Clear() override
		{
			m_Vector.clear();
		}

		virtual void ReserveVec(uint32_t size) override
		{
			m_Vector.reserve(size);
		}

		virtual void ResizeVec(uint32_t size) override
		{
			m_Vector.resize(size);
		}
	private:
		std::vector<std::vector<T>> m_Vector;
	};

	template<typename T, uint32_t _SizeArray>
	class AutoVectorArray : public BaseAutoVector<T>
	{
	public:
		AutoVectorArray()
			: m_Vector()
		{
		}

		virtual ~AutoVectorArray()
		{
			m_Vector.clear();
			m_Vector.shrink_to_fit();
		}

		virtual T& At(uint32_t index) override
		{
			RY_CORE_NOT_IMPL();
			return T();
		}

		virtual const T& At(uint32_t index) const override
		{
			RY_CORE_NOT_IMPL();
			return T();
		}


		virtual T& At(uint32_t index) override
		{
			RY_CORE_NOT_IMPL();
			return T();
		}

		virtual std::array<T, _SizeArray>& At(uint32_t index) override
		{
			RY_CORE_ASSERT(index <= Size(), "We dont push a Vector not more then one Element! You try to push {} new Elements in.", index - Size());
			if (index == Size())
				m_Vector.emplace_back<std::vector<T>>(std::vector<T>{});
			std::array<T, _SizeArray>& array = m_Vector.at(index);

			return array;
		}

		virtual const std::array<T, _SizeArray>& At(uint32_t index) const override
		{
			RY_CORE_ASSERT(index < Size(), "We dont push a Vector not in a Const Call! You try to push {} new Elements in.", index - Size());

			const std::array<T, _SizeArray>& array = m_Vector.at(index);

			return array;
		}

		virtual T& AtAt(uint32_t x, uint32_t y = MAXUINT32) override
		{
			RY_CORE_ASSERT(y != MAXUINT32);
			RY_CORE_ASSERT(x <= Size(), "We dont push a Vector not more then one Element! You try to push {} new Elements in.", x - Size());
			if (x == Size())
				m_Vector.emplace_back<std::vector<T>>(std::vector<T>{});
			std::array<T, _SizeArray>& array = m_Vector.at(x);

			uint32_t sizeVecInVec = static_cast<uint32_t>(array.size());
			RY_CORE_ASSERT(y < sizeVecInVec, "We dont push a Vector not more then one Element! You try to push {} new Elements in.", y - sizeVecInVec);


			return array.at(y);
		}

		virtual const T& AtAt(uint32_t x, uint32_t y = MAXUINT32) const override
		{
			RY_CORE_ASSERT(y != MAXUINT32);
			RY_CORE_ASSERT(x < Size(), "We dont push a Vector not in a Const Call! You try to push {} new Elements in.", x - Size());

			const std::array<T>& array = m_Vector.at(x);

			uint32_t sizeVecInVec = static_cast<uint32_t>(array.size());
			RY_CORE_ASSERT(y < sizeVecInVec, "We dont push a Vector not in a Const Call! You try to push {} new Elements in.", y - sizeVecInVec);


			return array.at(y);
		}



		virtual uint32_t Size() const override { return static_cast<uint32_t>(m_Vector.size()); }

		virtual void Clear() override
		{
			m_Vector.clear();
		}

		virtual void ReserveVec(uint32_t size) override
		{
			m_Vector.reserve(size);
		}

		virtual void ResizeVec(uint32_t size) override
		{
			m_Vector.resize(size);
		}
	private:
		std::vector<std::array<T, _SizeArray>> m_Vector;
	};
#endif

